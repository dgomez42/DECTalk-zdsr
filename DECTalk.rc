#include <windows.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDD_SETTINGS DIALOGEX 0, 0, 208, 56
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_CAPTION | WS_SYSMENU
CAPTION "DECTalk Settings"
FONT 12, "Segoe UI"
{
    LTEXT       "Language:", IDC_LANG_STATIC, 7, 8, 32, 10
    COMBOBOX    IDC_LANG_COMBO, 42, 6, 155, 80, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    DEFPUSHBUTTON "OK", IDOK, 55, 28, 44, 14, WS_TABSTOP
    PUSHBUTTON  "Cancel", IDCANCEL, 109, 28, 44, 14, WS_TABSTOP
}
